+bool
+ControlAllocator::update_shared_tilt_setpoint(bool torque_updated)
+{
+	const bool request_updated = _shared_tilt_setpoint_sub.update(&_shared_tilt_request);
+	const auto &request = _shared_tilt_request;
+	const hrt_abstime now = hrt_absolute_time();
+
+	if (!_armed || !_publish_controls || request.timestamp == 0 || request.timestamp > now
+	    || now - request.timestamp >= 100_ms) {
+		_shared_tilt_outputs_enabled = false;
+		return false;
+	}
+
+	if (request.mode == shared_tilt_allocation_setpoint_s::HOLD) {
+		return false; // Keep the last bounded output and allocation status during the outer loop's grace period.
+	}
+
+	if (request.mode != shared_tilt_allocation_setpoint_s::ACTIVE
+	    || request.timestamp_sample == 0 || request.timestamp_sample > request.timestamp
+	    || !PX4_ISFINITE(request.tilt_rad) || fabsf(request.tilt_rad) > math::radians(60.f)
+	    || !PX4_ISFINITE(request.collective) || request.collective < 0.f
+	    || _torque_timestamp == 0 || _torque_timestamp > now || now - _torque_timestamp >= 100_ms
+	    || !_torque_sp.isAllFinite()) {
+		_shared_tilt_outputs_enabled = false;
+		return false;
+	}
+
+	auto &effectiveness = static_cast<ActuatorEffectivenessSharedTilt &>(*_actuator_effectiveness);
+
+	// Rebuild before allocating so the matrix and projected force use the same actual angle.
+	if (!(fabsf(effectiveness.matrixTilt() - request.tilt_rad) <= FLT_EPSILON)) {
+		effectiveness.setTilt(request.tilt_rad);
+		update_effectiveness_matrix_if_needed(EffectivenessUpdateReason::NO_EXTERNAL_UPDATE);
+
+		if (!(fabsf(effectiveness.matrixTilt() - request.tilt_rad) <= FLT_EPSILON)) {
+			_shared_tilt_outputs_enabled = false;
+			return false;
+		}
+
+	} else if (!request_updated && !torque_updated && _shared_tilt_outputs_enabled) {
+		return false;
+	}
+
+	_thrust_sp = ActuatorEffectivenessSharedTilt::thrustAxis(request.tilt_rad) * request.collective;
+	_shared_tilt_sample_us = request.timestamp_sample;
+	_shared_tilt_outputs_enabled = true;
+	return true;
+}
